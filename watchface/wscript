#
# Popeye G&W Clock. A separate watchface package that reuses the game's pure
# modules and artwork from the repository root instead of copying them.
#
import sys

from waflib.TaskGen import after_method, before_method, feature

top = '.'
out = 'build'

# Shared with the game app: scene model, clock scene and rules (for the demo pose).
SHARED_SOURCES = ['../src/c/scene.c', '../src/c/clock.c', '../src/c/game.c']
SHARED_INCLUDES = ['../src/c']


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')
    ctx.env.BUNDLE_NAME = 'popeye-gw-clock.pbw'
    ctx.add_post_fun(check_app_size)

    binaries = []
    shared = [ctx.path.find_node(path) for path in SHARED_SOURCES]
    if None in shared:
        ctx.fatal('Shared game sources not found next to watchface/')
    shared_includes = [ctx.path.find_node(path) for path in SHARED_INCLUDES]

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c') + shared,
                      includes=shared_includes, target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js', 'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js',
                   keep_debug_maps_local=True)


@feature('js')
@after_method('process_js')
@before_method('make_pbl_bundle')
def exclude_debug_maps_from_pbw(self):
    """SDK 4.33.1's merge_js emits both JS and a source map, then make_pbl_bundle
    packages everything in task_gen.js. Keep the generated map in build/ for
    local debugging, while the PBW ships only the code needed by PebbleKit JS.
    Use Waf's task-generator hook rather than changing the SDK or editing a PBW.
    """
    if getattr(self, 'keep_debug_maps_local', False):
        self.js = [node for node in self.js if not node.name.endswith('.js.map')]


@feature('c')
@after_method('process_source')
def wait_for_resource_ids(self):
    """pebble.h includes the generated src/resource_ids.auto.h, but the scanner does not
    record it for these sources, so a parallel build could compile before it exists."""
    header = self.path.get_bld().make_node('{}/src/resource_ids.auto.h'.format(self.env.BUILD_DIR))
    for task in getattr(self, 'compiled_tasks', []):
        task.dep_nodes.append(header)


def check_app_size(ctx):
    """Check the linked image against the repository budget with SDK binutils."""
    checker = ctx.path.find_node('../tools/check_app_size.py').abspath()
    for platform in ctx.env.TARGET_PLATFORMS:
        platform_env = ctx.all_envs[platform]
        elf = ctx.bldnode.make_node(
            '{}/pebble-app.elf'.format(platform_env.BUILD_DIR)).abspath()
        if ctx.exec_command([sys.executable, checker, '--size-tool',
                             platform_env.SIZE, elf]):
            ctx.fatal('App image budget check failed for {}'.format(platform))
